---
type Props = {
  /** The letter a card is filed under, highlighted like a thumb-index tab. */
  active: string;
};

const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const { active } = Astro.props;
---

<!-- Decorative: the hero card's own text already says what it is filed under. -->
<ol class="strip typed" aria-hidden="true">
  {LETTERS.map((letter) => <li class:list={{ on: letter === active }}>{letter}</li>)}
</ol>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(13, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    text-align: center;
  }

  li {
    padding-block: 0.15rem;
    border-radius: 2px;
    color: color-mix(in srgb, var(--ink) 55%, transparent);
  }

  /* Without animation (reduced motion, or no CSS animation support) the tab is already marked. */
  li.on {
    background: var(--mark);
    color: var(--on-mark);
    font-weight: 700;
  }

  @media (min-width: 40rem) {
    .strip {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(26, 1fr);
      align-items: center;
      font-size: 0.8rem;
      line-height: 1;
      width: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    li.on {
      animation: tab-mark 0.35s ease-out both;
      animation-delay: var(--tab-delay, 3s);
    }
  }

  @keyframes tab-mark {
    from {
      background: transparent;
      color: color-mix(in srgb, var(--ink) 55%, transparent);
      font-weight: 400;
    }
  }
</style>
