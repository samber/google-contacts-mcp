---
import IndexCard from './IndexCard.astro';

// Fictional sender; 01 99 00 xx xx is the numbering range reserved for fiction in France.
const SIGNATURE = ['Camille Durand', 'CTO, Acme', '+33 1 99 00 12 34', 'camille@acme.example', 'linkedin.com/in/c-durand'];
const FIELDS = [
  { label: 'Company', value: 'Acme' },
  { label: 'Title', value: 'CTO' },
  { label: 'Phone', value: '+33 1 99 00 12 34' },
  { label: 'E-mail', value: 'camille@acme.example' },
  { label: 'LinkedIn', value: 'linkedin.com/in/c-durand' },
];
---

<section class="demo" aria-labelledby="demo-title">
  <div class="copy">
    <h2 id="demo-title">From an e-mail signature to a contact</h2>
    <p>
      Ask your assistant to read the signature of an e-mail and add the sender. It fills the empty fields and never
      overwrites what you already wrote. It needs your assistant's own e-mail connector to read the message.
    </p>
  </div>
  <div class="pair">
    <figure>
      <IndexCard class="signature">
        <p class="typed sig">{SIGNATURE.map((line) => <span>{line}</span>)}</p>
      </IndexCard>
      <figcaption>The signature in an e-mail</figcaption>
    </figure>
    <figure>
      <IndexCard header="Durand, Camille">
        <dl>
          {
            FIELDS.map((field) => (
              <div class="field">
                <dt>{field.label}</dt>
                <dd class="typed">{field.value}</dd>
              </div>
            ))
          }
        </dl>
      </IndexCard>
      <figcaption>The contact in Google Contacts</figcaption>
    </figure>
  </div>
</section>

<style>
  .demo {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .demo {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-6);
    }
  }

  .copy {
    display: grid;
    gap: var(--space-3);
  }

  .copy p {
    max-width: var(--measure-text);
  }

  .pair {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  figure {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  figcaption {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .sig {
    display: grid;
    font-size: var(--step--1);
  }

  /* The signature is plain, unruled text: it is not on a card yet. */
  figure:first-child {
    transform: rotate(-1.2deg);
  }

  dl {
    margin: 0;
  }

  .field {
    display: grid;
    /* Label above value: an e-mail address never breaks mid-word in this narrow card. */
    grid-template-columns: 1fr;
    padding-block: 0.2rem;
  }

  dt {
    font-size: var(--step--1);
    font-weight: 600;
    color: color-mix(in srgb, var(--ink) 65%, transparent);
  }

  dd {
    margin: 0;
    font-size: var(--step--1);
  }
</style>
