---
import IndexCard from '../components/IndexCard.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Google Contacts MCP"
  description="This page does not exist."
  path="/404"
  noindex
>
  <div class="wrap lost">
    <IndexCard header="Not filed">
      <h1>Page not found</h1>
      <p>No card is filed under this address. <a href="/">Go to the home page</a>.</p>
    </IndexCard>
  </div>
</Base>

<style>
  .lost {
    max-width: 36rem;
    padding-block: var(--space-6) 0;
  }

  h1 {
    margin-bottom: var(--space-2);
    font-size: var(--step-3);
  }
</style>
